<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/consoleToolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        app:title="Blinko Console" app:titleTextColor="#FFFFFF" android:background="#121212" app:menu="@menu/console_menu" app:navigationIcon="@android:drawable/ic_menu_delete" app:navigationContentDescription="Clear" />
    <LinearLayout android:id="@+id/faultBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
        android:padding="12dp" android:background="#2A1010" android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚠" android:textColor="#FF5252" android:textSize="18sp" android:paddingRight="10dp" />
        <TextView android:id="@+id/faultText" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:typeface="monospace" android:textSize="13sp" />
    </LinearLayout>
    <TextView android:id="@+id/consoleHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingLeft="16dp" android:paddingTop="10dp" android:paddingBottom="4dp"
        android:textColor="#9CDF9C" android:textSize="12sp" android:text="MESSAGES" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/console" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
