<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#000000">
    <FrameLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <FrameLayout android:id="@+id/live" android:layout_width="match_parent" android:layout_height="match_parent"><include layout="@layout/tab_live" /></FrameLayout>
        <FrameLayout android:id="@+id/consoleTab" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone"><include layout="@layout/tab_console" /></FrameLayout>
        <ScrollView android:id="@+id/lab" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:fillViewport="true">
            <LinearLayout android:id="@+id/labBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" />
        </ScrollView>
        <ScrollView android:id="@+id/settings" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:fillViewport="true">
            <LinearLayout android:id="@+id/settingsBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" />
        </ScrollView>
    </FrameLayout>
    <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/nav" android:layout_width="match_parent" android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav" app:labelVisibilityMode="labeled" android:background="#121212" />
</LinearLayout>
